{
   "compilerOptions": {
      "lib": ["es2023"],
      "target": "es2023",
      "module": "esnext",
      "moduleResolution": "bundler",
      "outDir": "dist",
      "resolveJsonModule": true,
      "emitDecoratorMetadata": true,
      "esModuleInterop": true,
      "experimentalDecorators": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "noEmit": true
   },
   "include": ["src/**/*.ts"],
   "exclude": ["node_modules", "**/*.spec.ts"]
}
