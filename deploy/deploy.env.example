# Copy to deploy/.env and fill in. Compose reads it for the stack's settings,
# and the API and worker get it as their environment.

# Public origin of the site. Caddy gets the HTTPS certificate for this domain,
# so point its DNS at the server before the first start.
SITE_URL=https://factions.example.com

# --- Backend (see ../.env.defaults for what each one does) ---
PORT=4000
WS_BASE_URL=wss://api.factions-online.com/wss/
API_BASE_URL=https://api.factions-online.com/api/
AUTH_TOKEN=
# openssl rand -hex 32
ADMIN_API_KEY=
REPORT_RATE_LIMIT=

# --- Database (not reachable from outside the stack) ---
DB_NAME=factions-game
DB_USER=factions
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Backups, written to deploy/backups ---
# Daily time in UTC, and how many days of dumps to keep.
BACKUP_TIME=04:00
BACKUP_KEEP_DAYS=14
