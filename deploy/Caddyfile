# SITE_URL is the public origin, e.g. https://factions.example.com. With an
# https:// domain, Caddy gets and renews the certificate itself.
{$SITE_URL} {
	encode zstd gzip

	# The API's routes have no /api prefix, so it's stripped here.
	handle_path /api/* {
		reverse_proxy server:{$PORT}
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
